@startuml Jacaloria - Fluxo de analise de alimentos
title Jacaloria — Análise de alimentos (visão Gemini + RAG TACO)
autonumber

skinparam shadowing false
skinparam roundCorner 10
skinparam defaultFontSize 13
skinparam sequenceArrowThickness 1.3

actor "Usuário" as user
participant "Flutter\nfood_analysis" as app
participant "CloudFront" as cf
participant "AiController" as api
participant "AiService" as svc
participant "Gemini" as gemini
participant "RAG TACO" as rag
database "Postgres" as pg

user -> app : foto do prato
app -> app : otimiza a imagem
app -> cf : POST /api/ai/food/analyze (JWT)
cf -> api : proxy /api/* (timeout 120s)
api -> api : JwtAuthGuard (user.sub)
api -> svc : analyzeFood(dto, userId)

svc -> gemini : generateContent (modelo primário)
alt cota ou erro do modelo
  gemini --> svc : falha
  svc -> gemini : fallback flash-lite / flash
end

gemini --> svc : itens e macros estimados
svc -> rag : enriquece nomes e kcal
rag --> svc : match TACO ou receita
svc -> pg : persiste food_image_analyses
svc --> api : JSON calibrado
api --> app
app --> user : revisão, edição e salvar refeição

@enduml
