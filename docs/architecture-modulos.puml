@startuml Jacaloria - Modulos da aplicacao
title Jacaloria — Módulos (Flutter e NestJS)
caption REST em /api com JWT (Authorization: Bearer). Dashboard interno em /beta.

skinparam shadowing false
skinparam roundCorner 12
skinparam defaultFontSize 13
skinparam ArrowColor #1E293B
skinparam ArrowThickness 1.3
skinparam nodesep 30
skinparam ranksep 40

skinparam package {
  BackgroundColor #F8FAFC
  BorderColor #64748B
  FontColor #0F172A
  FontStyle bold
}
skinparam rectangle {
  BorderColor #1E293B
  FontColor #0F172A
}

package "Flutter  frontend/lib" as flutter #ECFDF3 {
  rectangle "**features/**\nauth, onboarding, home\nfood_analysis, social, missions\nprofile, avatar_frames\nsupport, legal" as features #BBF7D0
  rectangle "**core/**\nApiConfig, analytics\nnotificações locais\nwidget Android, convites" as core #86EFAC
  rectangle "**shared/**\nSupabaseStorageService\ntheme, widgets" as fshared #4ADE80
}

package "NestJS  backend/src  /api" as nest #EFF6FF {
  rectangle "**AuthModule**  /auth" as auth #93C5FD
  rectangle "**AiModule**  /ai" as ai #60A5FA
  rectangle "**Meals + Templates**" as meals #93C5FD
  rectangle "**SocialModule**  /social" as social #93C5FD
  rectangle "**MissionsModule**  /missions" as missions #93C5FD
  rectangle "**Ops**\nperformance, notifications\nanalytics, support, health" as ops #BFDBFE
  rectangle "**Compartilhado**\nMail, Streak, Database (Sequelize)" as shared_be #DBEAFE
}

rectangle "**Supabase Storage**\navatars, meals, group-chat" as storage_note #DDD6FE

features --> nest : HTTP JSON
core --> nest : HTTP JSON
fshared --> storage_note : upload direto

auth --> shared_be
ai --> shared_be
meals --> shared_be
social --> shared_be
missions --> shared_be
ops --> shared_be
auth --> missions : streak / ouro
ai --> ops : eventos de análise

@enduml
