{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Principal": {
        "Federated": "arn:aws:iam::942226532350:oidc-provider/token.actions.githubusercontent.com"
      },
      "Action": "sts:AssumeRoleWithWebIdentity",
      "Condition": {
        "StringEquals": {
          "token.actions.githubusercontent.com:aud": "sts.amazonaws.com"
        },
        "StringLike": {
          "token.actions.githubusercontent.com:sub": [
            "repo:israelhub/JacalorIA-CONTADOR-DE-CALORIAS:ref:refs/heads/main",
            "repo:israelhub/concursai:ref:refs/heads/main"
          ]
        }
      }
    }
  ]
}
